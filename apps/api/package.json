    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "otpauth": "^9.6.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "testpulse": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
