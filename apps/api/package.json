    "db:studio": "drizzle-kit studio",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.2.0",
