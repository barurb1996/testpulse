DATABASE_URL=postgres://testpulse:testpulse@localhost:5432/testpulse
PORT=3001
HOST=0.0.0.0

# Required: the API refuses every /api request until this is set. Use a long random value.
ADMIN_PASSWORD=
# Required in production: 64 hex chars, encrypts repo tokens / Slack webhooks / MFA secret. openssl rand -hex 32
ENCRYPTION_KEY=
# Origin(s) of the dashboard when it is served from a different origin than the API (comma separated)
CORS_ORIGIN=
# Set to true behind a reverse proxy (Railway, nginx) so rate limits and login lockouts use the real client IP
TRUST_PROXY=
# Extra hosts allowed for outbound webhooks (hooks.slack.com is always allowed)
WEBHOOK_ALLOWED_HOSTS=
ANTHROPIC_API_KEY=
