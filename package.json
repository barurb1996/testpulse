{
  "name": "testpulse-workspace",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "check": "pnpm run typecheck && pnpm run test && node scripts/check-package.mjs && node scripts/gen-rules-doc.mjs"
  },
  "devDependencies": {
    "turbo": "^2.11.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": ">=0.8.15",
      "brace-expansion@<5.0.7": ">=5.0.7",
      "minimatch@<11.0.1": ">=11.0.1",
      "fast-uri": ">=3.1.9",
      "fast-xml-builder": ">=1.1.7",
      "find-my-way": ">=9.7.0",
      "postcss": ">=8.5.23",
      "nanoid": ">=3.3.18",
      "source-map-js": ">=1.2.2"
    }
  }
}
