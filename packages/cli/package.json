{
  "name": "testpulse",
  "version": "0.2.1",
  "description": "Static analysis for test suites: finds tests that pass but verify nothing, plus security-test gaps (Playwright, Karate, Cucumber)",
  "license": "MIT",
  "keywords": [
    "testing",
    "test-quality",
    "static-analysis",
    "playwright",
    "karate",
    "cucumber",
    "qa",
    "openapi",
    "security",
    "ai-generated-tests",
    "mcp"
  ],
  "homepage": "https://testpulse.app",
  "bugs": {
    "url": "https://github.com/barurb1996/testpulse/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barurb1996/testpulse.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "testpulse": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.d.ts",
    "!dist/**/*.d.ts.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node scripts/run-tests.mjs",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build && node dist/index.js --version"
  },
  "dependencies": {
    "@typescript-eslint/typescript-estree": "^8.73.0",
    "fast-xml-parser": "^5.12.1",
    "js-yaml": "^4.3.2",
    "mammoth": "^1.13.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
